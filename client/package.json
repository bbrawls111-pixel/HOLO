{
  "name": "holo",
  "productName": "Holo",
  "version": "0.4.3",
  "private": true,
  "description": "Holo — приватное рабочее пространство для разработки игры",
  "author": "Holo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "icon": "electron build/make-icon.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "app.holo.workspace",
    "productName": "Holo",
    "copyright": "Holo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Holo-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Holo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.12.1",
    "concurrently": "^9.1.0",
    "echarts": "^5.6.0",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.1"
  }
}
